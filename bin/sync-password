#!/usr/bin/env bash
set -euo pipefail

ROOT="${DEVCONTAINER_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PASSWORD_FILE="$ROOT/shared/ssh/container-password-hash"
DEV_USER="${DEV_USER:-$(id -un)}"

if ! command -v openssl >/dev/null 2>&1; then
  echo "openssl is required" >&2
  exit 1
fi

read -r -s -p "Enter the host password for $DEV_USER: " password
printf '\n'

if [[ -z "$password" ]]; then
  echo "password cannot be empty" >&2
  exit 1
fi

umask 077
mkdir -p "$(dirname "$PASSWORD_FILE")"
printf '%s\n' "$(openssl passwd -6 -stdin <<<"$password")" > "$PASSWORD_FILE"
unset password
chmod 600 "$PASSWORD_FILE"
echo "Container password hash synchronized from the host password input."
